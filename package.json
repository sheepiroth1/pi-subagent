{
  "name": "pi-subagent-anchor",
  "version": "0.1.0",
  "private": true,
  "description": "KV-cache friendly sub-agents for Pi with selectable inherited context (anchors). Fork of clanker-wanker/pi-subagent.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "anchors.ts",
    "delivery.ts",
    "merge.ts",
    "runner.ts",
    "queue.ts",
    "runner-cli.js",
    "runner-events.js",
    "render.ts",
    "types.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "check": "tsc -p ."
  },
  "keywords": [
    "pi",
    "subagent",
    "delegation",
    "kv-cache",
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
